table dim_category
	lineageTag: 7115f9e5-3a2e-410e-8c31-fba8ff99dd39
	sourceLineageTag: [gold].[dim_category]

	measure 'Total Sales' =
			
			SUM(fact_sales[Sales])
		lineageTag: 4257d1a2-c5ef-4d0c-a039-94769420fcd3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Quantity' =
			
			SUM(fact_sales[Quantity])
		lineageTag: c4f0c483-cf19-44dc-861c-8572664ea334

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' =
			
			DISTINCTCOUNT(fact_sales[Order_ID])
		formatString: 0
		lineageTag: a774de1b-4f51-459f-a580-c76cde354838

		changedProperty = Name

	measure 'Total Profit' =
			
			SUM(fact_sales[Profit])
		lineageTag: 708e585a-3917-461c-bf3b-7c9b84e3cd7a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Customers' =
			
			DISTINCTCOUNT(fact_sales[customer_sk])
		formatString: 0
		lineageTag: 996a2517-3a0a-4634-9038-58644cb10594

		changedProperty = Name

	measure 'Profit Margin' =
			
			DIVIDE([Total Profit],[Total Sales],0)
		lineageTag: 8ef9f120-34cc-4f61-8893-b6dfd4f919d9

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

